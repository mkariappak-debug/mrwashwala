# Example environment variables for Mr. Washwala server
# Copy this file to .env and fill in real values (do NOT commit .env)

# MongoDB connection string (replace placeholders)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# Server runtime
NODE_ENV=development
PORT=5000

# Frontend origin allowlist for CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=https://mrwashwala.com,https://www.mrwashwala.com

# SMTP credentials used for franchise lead notifications
EMAIL_USER=youremail@example.com
EMAIL_PASS=your_app_password
