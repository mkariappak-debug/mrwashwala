# Example environment variables for Mr. Washwala client
# Copy this file to .env and fill in real values (do NOT commit .env)

# Backend API base URL.
# Example local backend: http://localhost:5005
VITE_API_URL=http://localhost:5005

# Google Maps key used by the map picker in checkout flow.
VITE_GOOGLE_MAPS_API_KEY=

# Temporary direct UPI payment configuration.
VITE_UPI_ID=your-upi-id@bank
VITE_UPI_PAYEE_NAME=Mr WashWala
