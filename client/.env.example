# Example environment variables for Mr. Washwala client
# Copy this file to .env and fill in real values (do NOT commit .env)

# Backend API base URL used in production build.
# Local dev can omit this and fallback to http://localhost:5000.
VITE_API_URL=

# Google Maps key used by the map picker in checkout flow.
VITE_GOOGLE_MAPS_API_KEY=
